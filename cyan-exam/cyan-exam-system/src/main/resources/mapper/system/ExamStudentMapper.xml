<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyan.exam.system.mapper.ExamStudentMapper">

    <!-- 批量插入考试学生关联 -->
    <insert id="batchInsertExamStudent">
        INSERT INTO exam_student (exam_id, user_id) VALUES
        <foreach collection="userIds" item="userId" separator=",">
            (#{examId}, #{userId})
        </foreach>
    </insert>

    <!-- 根据考试ID删除所有学生关联 -->
    <delete id="deleteExamStudentByExamId" parameterType="Long">
        DELETE FROM exam_student WHERE exam_id = #{examId}
    </delete>

    <!-- 根据考试ID查询已分配的学生userId列表 -->
    <select id="selectUserIdsByExamId" parameterType="Long" resultType="Long">
        SELECT user_id FROM exam_student WHERE exam_id = #{examId}
    </select>

    <!-- 根据学生ID查询其分配的考试ID列表 -->
    <select id="selectExamIdsByUserId" parameterType="Long" resultType="Long">
        SELECT exam_id FROM exam_student WHERE user_id = #{userId}
    </select>
</mapper>